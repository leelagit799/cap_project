      "updated": 1,
      "link": null,
      "locked": false,
      "text": "HITL-1 (inside validation)\n\nMCP Elicitation during rules_engine:\n• Missing non-blocking field?\n• Streamlit elicitation_callback\n• accept → fill & continue\n• decline → flag for human\n• cancel → abort validation",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "bx16",
      "originalText": "HITL-1 (inside validation)\n\nMCP Elicitation during rules_engine:\n• Missing non-blocking field?\n• Streamlit elicitation_callback\n• accept → fill & continue\n• decline → flag for human\n• cancel → abort validation",
      "lineHeight": 1.2,
      "index": "tbx16"
    },
