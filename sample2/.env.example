# DischargeFlow environment configuration
# Copy to .env and fill in. NEVER commit .env — it is git-ignored.

# --- AWS Bedrock (primary LLM: Nova Lite; fallback: Cohere Command R+ via Bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_PRIMARY_MODEL=bedrock/amazon.nova-lite-v1:0
BEDROCK_FALLBACK_MODEL=bedrock/cohere.command-r-plus-v1:0

# --- Cohere direct API (optional; only if not routing Command R+ through Bedrock) ---
COHERE_API_KEY=

# --- LangFuse observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- A2A shared-secret authentication (sent as X-Agent-Auth-Token) ---
AGENT_AUTH_TOKEN=

# --- Runtime toggles ---
# 1 = deterministic offline LLM stub (no network); 0 = live Bedrock/Cohere via LiteLLM
LLM_OFFLINE=0
LOG_LEVEL=INFO
