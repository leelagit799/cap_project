# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Python virtual environments — NEVER commit these.
# Windows creates .venv/Scripts/ ; Linux/Mac creates .venv/bin/
.venv/
venv/
**/.venv/
**/venv/
sample2/.venv/
.mypy_cache/
.ruff_cache/

# Generated runtime data
sample2/data/*
!sample2/data/.gitkeep
!sample2/data/reports/.gitkeep
!sample2/data/sessions/.gitkeep
!sample2/data/state/.gitkeep
!sample2/data/vector_db/.gitkeep
sample2/mock_ehr/data/*
!sample2/mock_ehr/data/*.json
*.sqlite
*.sqlite3
*.faiss

# OS / editor
.DS_Store
Thumbs.db
